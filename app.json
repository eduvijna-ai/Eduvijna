{
  "expo": {
    "name": "EduVijna",
    "slug": "eduvijna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduvijna.app",
      "infoPlist": {
        "NSCameraUsageDescription": "EduVijna uses the camera so you can photograph textbook and handwritten pages to generate quizzes.",
        "NSPhotoLibraryUsageDescription": "EduVijna accesses your photos so you can pick document pages to generate quizzes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eduvijna.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-foreground.png",
        "backgroundColor": "#1B4F5C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.eduvijna.com",
              "pathPrefix": "/openquiz"
            },
            {
              "scheme": "eduvijna"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "eduvijna",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EduVijna uses the camera so you can photograph textbook and handwritten pages to generate quizzes.",
          "photosPermission": "EduVijna accesses your photos so you can pick document pages to generate quizzes.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "./plugins/withCropButtonLabel",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "API_BASE_URL": "https://eduapi.eduvijna.com",
      "eas": {
        "projectId": "60acc689-aea1-4ce1-9770-4200c1c17c00"
      }
    },
    "owner": "samathakotikanyadanam"
  }
}

{
  "expo": {
    "name": "EduVijna",
    "slug": "eduvijna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/eduvijna.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduvijna.app"
    },

    "android": {
      "package": "com.eduvijna.app",

      "adaptiveIcon": {
        "foregroundImage": "./assets/eduvijna.png",
        "backgroundColor": "#ffffff"
      },

      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ui.eduvijna.com",
              "pathPrefix": "/openquiz"
            },
            {
              "scheme": "eduvijna"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "scheme": "eduvijna",

    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },

    "runtimeVersion": "1.0.0",

    "plugins": ["expo-notifications"],

    "experiments": {
      "typedRoutes": false
    },

    "extra": {
      "eas": {
        "projectId": "60acc689-aea1-4ce1-9770-4200c1c17c00"
      }
    },

    "owner": "samathakotikanyadanam"
  }
}

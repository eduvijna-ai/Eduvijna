{
  "name": "eduvijna",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:device": "node scripts/with-eduvijna-api-env.mjs development -- expo start --dev-client --lan",
    "start:production": "node scripts/with-eduvijna-api-env.mjs production -- expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "config:verify": "node scripts/verify-expo-api-config.mjs",
    "cli:verify": "node scripts/with-eduvijna-api-env.mjs development -- eas --version",
    "bundle:verify:development": "node scripts/with-eduvijna-api-env.mjs development -- expo export --platform android --output-dir .expo-export-check/android-dev && node scripts/with-eduvijna-api-env.mjs development -- expo export --platform ios --output-dir .expo-export-check/ios-dev",
    "bundle:verify:production": "node scripts/with-eduvijna-api-env.mjs production-release -- expo export --platform android --output-dir .expo-export-check/android-prod && node scripts/with-eduvijna-api-env.mjs production-release -- expo export --platform ios --output-dir .expo-export-check/ios-prod",
    "update:production": "node scripts/with-eduvijna-api-env.mjs production-release -- eas update",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "patch-package",
    "test": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --forceExit --runInBand",
    "test:watch": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --watch --forceExit --runInBand",
    "test:coverage": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --coverage --forceExit --runInBand",
    "test:journey-logic": "node --test scripts/__tests__/android-founder-journey.logic.test.mjs scripts/__tests__/android-journey-tap.test.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "workerIdleMemoryLimit": "512MB",
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|zustand)"
    ],
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@context/(.*)$": "<rootDir>/src/context/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@platforms/(.*)$": "<rootDir>/src/platforms/$1",
      "^@mobile/(.*)$": "<rootDir>/src/platforms/mobile/$1",
      "^react-native-original$": "<rootDir>/node_modules/react-native"
    },
    "collectCoverageFrom": [
      "src/screens/CreateDocumentQuizScreen.tsx",
      "src/screens/CreateHandwrittenQuizScreen.tsx",
      "src/core/store/assessmentWorkspace.store.ts",
      "src/core/services/sharedApi.ts"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.5.10",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "@tanstack/react-query": "^4.42.0",
    "@types/redis": "^4.0.10",
    "axios": "^1.5.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-doctor": "^1.19.8",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "formik": "^2.4.6",
    "katex": "^0.16.27",
    "npx": "^10.2.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-katex": "^1.3.0",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "yup": "^1.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native-community/cli": "^20.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.10",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^16.27.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.3"
  }
}

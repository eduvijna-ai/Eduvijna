# ⚠️ IMPORTANT: Cache Configuration for React Native

# React Native CANNOT use Redis directly because it requires Node.js built-in modules
# The 'redis' package attempts to import 'node:crypto' which is not available in React Native

# Instead, we use a multi-layer caching system:
# - L1: In-Memory Cache (fast, lost on app restart)
# - L2: AsyncStorage (persistent, survives app restarts)

# ============================================================================
# CACHE TTL CONFIGURATION (in seconds)
# ============================================================================

# Dashboard caching - frequently accessed, moderate TTL
CACHE_TTL_DASHBOARD_SUMMARY=300          # 5 minutes
CACHE_TTL_QUIZZES_LIST=600               # 10 minutes
CACHE_TTL_CLASSROOMS=1800                # 30 minutes
CACHE_TTL_STUDENTS_LIST=900              # 15 minutes

# User profile - stable data, longer TTL
CACHE_TTL_USER_PROFILE=3600              # 1 hour

# Quiz details - moderately changing data
CACHE_TTL_QUIZ_DETAILS=1800              # 30 minutes

# Analytics - can be slightly stale
CACHE_TTL_ANALYTICS=1800                 # 30 minutes

# Default TTL for uncategorized cache entries
CACHE_TTL_DEFAULT=300                    # 5 minutes

# ============================================================================
# CACHE BEHAVIOR
# ============================================================================

# Automatic cleanup interval (milliseconds)
# Removes expired cache entries from both layers
CACHE_CLEANUP_INTERVAL=300000            # 5 minutes

# Enable detailed cache logging
CACHE_LOGGING_ENABLED=true

# Log cache statistics periodically
CACHE_STATS_LOGGING_ENABLED=true
CACHE_STATS_INTERVAL=600000              # 10 minutes

# ============================================================================
# FOR BACKEND SERVICES (Node.js/Python servers)
# ============================================================================

# If you have a backend API server, you CAN use Redis there!
# These settings would go in your backend .env file, NOT the React Native app

# BACKEND_REDIS_HOST=redis-prod.eduvijna.com
# BACKEND_REDIS_PORT=6379
# BACKEND_REDIS_PASSWORD=eduvijnaprod@cache
# BACKEND_REDIS_URL=redis://:eduvijnaprod@cache@redis-prod.eduvijna.com:6379/0
# BACKEND_REDIS_ENABLED=true
# BACKEND_REDIS_TTL_DEFAULT=300

# ============================================================================
# NOTES
# ============================================================================

# ✅ React Native App Cache: AsyncStorage + Memory (this app)
# ✅ Backend API Cache: Redis (if you have a separate backend)
# ❌ React Native App: CANNOT use Redis directly

# Cache Strategy:
# 1. First request: Cache MISS -> API call -> Store in L1 + L2
# 2. Subsequent requests: Cache HIT (L1) -> Return immediately
# 3. After app restart: Cache HIT (L2) -> Promote to L1 -> Return
# 4. After TTL expiry: Cache MISS -> API call -> Refresh cache

# Logging Example:
# ✅ [timestamp] [L1 MEMORY HIT] key | Source: Memory Cache | Age: 45s
# ✅ [timestamp] [L2 STORAGE HIT] key | Source: AsyncStorage | Age: 120s
# ❌ [timestamp] [CACHE MISS] key | Will fetch from API
# 🌐 [timestamp] [API CALL START] key | Fetching fresh data...
# ✅ [timestamp] [API CALL SUCCESS] key | Duration: 500ms | Data cached for 300s

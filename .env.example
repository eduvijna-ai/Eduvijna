# Copy to .env for local overrides (never commit .env).
#
# Required whenever Expo evaluates app.config.ts (Metro, export, prebuild):
#   EDUVIJNA_API_ENV=development | production
#
# Origins (no /api/v1 suffix — services append paths):
#   development → https://dev-api.eduvijna.com
#   production  → https://eduapi.eduvijna.com
#
# npm scripts set EDUVIJNA_API_ENV automatically. For raw `npx expo` commands,
# export EDUVIJNA_API_ENV explicitly or Expo will fail fast (no silent production).
#
EDUVIJNA_API_ENV=development

# Optional origin override (development only). Restart Metro after changes.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# Legacy name — not read by the mobile app:
# EXPO_PUBLIC_API_URL=

# E2E fixture probe only (scripts/probe-dev-e2e-fixtures.mjs) — never commit values.
# EDUVIJNA_DEV_INSTRUCTOR_EMAIL=
# EDUVIJNA_DEV_INSTRUCTOR_PASSWORD=
# EDUVIJNA_DEV_STUDENT_EMAIL=
# EDUVIJNA_DEV_STUDENT_PASSWORD=
